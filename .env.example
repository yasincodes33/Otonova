# Geliştirme ortamı için bu dosyayı .env olarak kopyalayın:
# cp .env.example .env

# Django Core
SECRET_KEY=django-insecure-buraya-guclu-bir-anahtar-girin
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Veritabanı (varsayılan: SQLite)
# PostgreSQL kullanmak için:
# DATABASE_URL=postgresql://kullanici:sifre@localhost:5432/otonova

# E-posta
# Geliştirme: console (terminale yazar)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
# Üretim: SMTP
# EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=
# EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=OtoNova <noreply@otonova.com.tr>

# Medya / Statik (üretimde S3 vb.)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_STORAGE_BUCKET_NAME=
